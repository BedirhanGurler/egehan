# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo
bin/
obj/
*.vsix

# generated chronicle artifacts (never commit the tool's own output from dev runs)
/EGEHAN.md
/egehan-chronicle.html
/.egehan/

# time capsules are never tracked — they may contain private letters
*.capsule.json
capsule.egehan.json

# os / editor
.DS_Store
Thumbs.db
.idea/
.vs/
*.user

# logs & temp
*.log
npm-debug.log*
.tmp/
coverage/

# generated from @egehan/core-spec by packages/node-cli/scripts/sync-spec.mjs
packages/node-cli/assets/

# generated by extensions/vscode-extension/scripts/build.mjs
extensions/vscode-extension/assets/
extensions/vscode-extension/dist/

# .NET build output
packages/dotnet-tool/**/bin/
packages/dotnet-tool/**/obj/

# .NET paket çıktısı
packages/dotnet-tool/nupkg/
